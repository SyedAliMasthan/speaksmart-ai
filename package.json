{
  "name": "speaksmart-ai",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file=.env.server server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check:security": "node scripts/check-security.mjs",
    "validate": "npm run check:security && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
